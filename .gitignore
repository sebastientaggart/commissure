__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Workspaces are local data: state.db, blobs/, outputs/, named workspace/ at any depth,
# plus state.db and the lock wherever --workspace pointed.
workspace/
state.db
state.db-wal
state.db-shm
state.db-journal
workspace.lock


# Solutions are separate projects; a solution checked out here is never part of core.
/solutions/

# Secrets stay local.
.env
.env.*
!.env.example
/secrets/

# OS and editor noise. Office lock files match ingest DEFAULT_IGNORE.
.DS_Store
._*
Thumbs.db
desktop.ini
~$*
.~lock.*#

# Personal agent and ide settings (permission rules for this machine only).
.claude/settings.local.json
.ignore
*.code-workspace

# Local work plans (ephemeral agent scratchpad).
docs/plans/
docs/plan-*.md
