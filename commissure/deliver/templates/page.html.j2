<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="icon" type="image/svg+xml" href="{{ static_prefix }}/favicon.svg">
  <link rel="stylesheet" href="{{ static_prefix }}/pico.min.css">
  <link rel="stylesheet" href="{{ static_prefix }}/report.css">
  {% if brand_css %}
  <link rel="stylesheet" href="{{ static_prefix }}/brand/brand.css">
  {% endif %}
  {% for name in scripts %}
  <script src="{{ static_prefix }}/{{ name }}"></script>
  {% endfor %}
</head>
<body>
  <div class="interface-state">
    <header class="app-header">
      <div class="app-header-inner">
        <div class="app-header-brand">
          <!-- commissure-serve-home -->
          {% if brand_header %}
          <div class="app-brand-slot">{{ brand_header }}</div>
          {% endif %}
          <div class="app-title-group">
            <h1 class="app-title">{{ title }}</h1>
            {% if subtitle %}
            <details id="app-info-disclosure" name="header-panel" class="header-disclosure header-info">
              <summary class="header-icon-btn" aria-label="About {{ title }}">
                <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <circle cx="8" cy="8" r="6.25"/>
                  <path d="M6.15 6.1a1.9 1.9 0 0 1 3.7.55c0 1.15-1.85 1.45-1.85 2.55"/>
                  <circle cx="8" cy="11.35" r="0.55" fill="currentColor" stroke="none"/>
                </svg>
              </summary>
              <div class="header-popover-card header-popover-left">
                <p>{{ subtitle }}</p>
              </div>
            </details>
            {% endif %}
          </div>
        </div>
        <!-- commissure-serve-controls -->
      </div>
    </header>

    <main class="container app-main">
      <!-- commissure-serve-banner -->
      {{ body }}
    </main>

    <footer class="site-footer app-footer">
      <div class="container app-footer-inner">{{ footer_html }}</div>
    </footer>
  </div>
  <script src="{{ static_prefix }}/report.js"></script>
</body>
</html>
