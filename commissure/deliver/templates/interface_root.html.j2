<div id="interface-root">
  <div class="interface-state" data-busy="{{ 'true' if view.locked and not review_mode else 'false' }}" data-page-title="{% if view.busy %}{{ view.busy.tab_title_prefix }} {% endif %}{{ title }}">
    <header class="app-header">
      <div class="app-header-inner">
        <div class="app-header-brand">
          {% if brand_header %}
          <div class="app-brand-slot">{{ brand_header }}</div>
          {% endif %}
          <div class="app-title-group">
            <h1 class="app-title">{{ title }}</h1>
            {% if subtitle %}
            <details id="app-info-disclosure" name="header-panel" class="header-disclosure header-info">
              <summary class="header-icon-btn" aria-label="About {{ title }}">
                <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <circle cx="8" cy="8" r="6.25"/>
                  <path d="M6.15 6.1a1.9 1.9 0 0 1 3.7.55c0 1.15-1.85 1.45-1.85 2.55"/>
                  <circle cx="8" cy="11.35" r="0.55" fill="currentColor" stroke="none"/>
                </svg>
              </summary>
              <div class="header-popover-card header-popover-left">
                <p>{{ subtitle }}</p>
              </div>
            </details>
            {% endif %}
          </div>
        </div>

        <div class="app-header-controls">
          {% if review_mode %}
          {#- No polling here: when a run ends the poll swaps in the home page, which would
              discard a verdict being written. Status is shown as of this page load. -#}
          {% if view.busy %}
          <span class="badge badge-warn review-run-status" title="Verdicts can still be recorded">Run in progress: {{ view.busy.short_label or view.busy.label }} ({{ view.busy.elapsed_display }})</span>
          {% endif %}
          <a class="header-home-link" href="/">&larr; {{ title }}</a>
          <a class="header-icon-btn" href="/review" aria-label="Review results" title="Review results" aria-current="page"><svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 2.9H4.75a1.25 1.25 0 0 0-1.25 1.25v8.6A1.25 1.25 0 0 0 4.75 14h6.5a1.25 1.25 0 0 0 1.25-1.25v-8.6A1.25 1.25 0 0 0 11.25 2.9H10"/><rect x="6" y="1.9" width="4" height="2.1" rx="0.6"/><path d="M5.9 9.05l1.5 1.5 2.75-3"/></svg></a>
          {% elif view.busy %}
          {% include "interface_busy_bar.html.j2" %}
          {% else %}
          <details id="idle-status-details" name="header-panel" class="header-disclosure header-status">
            <summary class="header-icon-btn{% if view.interrupted_step %} header-icon-attention{% endif %}" aria-label="{{ 'Needs attention' if view.interrupted_step else 'Idle' }}">
              {% if view.interrupted_step %}
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.2"/><path d="M8 4.8v3.6"/><circle cx="8" cy="11.1" r="0.6" fill="currentColor" stroke="none"/></svg>
              {% else %}
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="4.4"/></svg>
              {% endif %}
            </summary>
            <div class="header-popover-card header-popover-right header-status-card">
              {% if view.interrupted_step %}
              <div class="status-card-title">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.2"/><path d="M8 4.8v3.6"/><circle cx="8" cy="11.1" r="0.6" fill="currentColor" stroke="none"/></svg>
                <span><strong>Interrupted run:</strong> <code>{{ view.interrupted_step }}</code></span>
              </div>
              <p class="status-card-note">
                Stopped before finishing. Run this step again to pick up where it left off.
              </p>
              {% else %}
              <div class="status-card-title">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="4.4"/></svg>
                <span><strong>Idle</strong></span>
              </div>
              <p class="status-card-note">
                {% if view.initialized %}
                {{ total_items }} active item(s) across {{ view.sources | length }} source(s). Steps: {{ pipeline_summary }}.
                {% else %}
                Not yet initialized (read-only until the first action or CLI run).
                {% endif %}
              </p>
              {% endif %}
            </div>
          </details>
          {% endif %}

          {% if not review_mode %}
          {% if view.initialized %}
          <a class="header-icon-btn" href="/review" aria-label="Review results" title="Review results"><svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 2.9H4.75a1.25 1.25 0 0 0-1.25 1.25v8.6A1.25 1.25 0 0 0 4.75 14h6.5a1.25 1.25 0 0 0 1.25-1.25v-8.6A1.25 1.25 0 0 0 11.25 2.9H10"/><rect x="6" y="1.9" width="4" height="2.1" rx="0.6"/><path d="M5.9 9.05l1.5 1.5 2.75-3"/></svg></a>
          {% endif %}
          <details id="pipeline-drawer" name="header-panel" class="header-disclosure header-pipeline"{% if pipeline_open %} open{% endif %}>
            <summary class="header-icon-btn{% if pipeline_tone in ('warn', 'error') %} header-icon-attention{% endif %}" aria-label="{{ 'Steps need attention' if pipeline_tone in ('warn', 'error') else 'Steps' }}">
              {% if pipeline_tone in ('warn', 'error') %}
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.2"/><path d="M8 4.8v3.6"/><circle cx="8" cy="11.1" r="0.6" fill="currentColor" stroke="none"/></svg>
              {% else %}
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.2 8.4l3.1 3.1 6.5-6.8"/></svg>
              {% endif %}
            </summary>

            <div class="header-drawer-panel">
              <div class="pipeline-toolbar">
                <p>
                  <strong>Workspace Pipeline Steps</strong>
                  <span class="muted">&mdash;
                    {% if view.initialized and total_items > 0 %}
                    Applies to all {{ total_items }} active item(s) across {{ view.sources | length }} source(s) in this workspace. Parsing and model calls reuse cached work; recipe stages refresh the workspace snapshot.
                    {% else %}
                    Applies across the entire workspace in declared dependency order. Manual <code>commissure run --step &lt;stage&gt;</code> commands share the same workspace database and lock.
                    {% endif %}
                  </span>
                </p>
                <form method="post" action="/_pipeline/run" hx-post="/_pipeline/run" hx-target="#interface-root" hx-swap="outerHTML" hx-disabled-elt="find button">
                  <input type="hidden" name="csrf_token" value="{{ view.csrf_token }}">
                  <input type="hidden" name="step" value="__all__">
                  <button type="submit" class="btn-compact"{% if view.locked %} disabled{% endif %}>Run All Steps in Order</button>
                  <span class="htmx-indicator run-busy-msg">Running pipeline...</span>
                </form>
              </div>

              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">#</th>
                      <th scope="col">Step</th>
                      <th scope="col">Scope</th>
                      <th scope="col">Needs</th>
                      <th scope="col">Status</th>
                      <th scope="col">Summary</th>
                      <th scope="col">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for step in view.steps %}
                    <tr>
                      <td>{{ step.order }}</td>
                      <td>
                        <code>{{ step.label }}</code>
                        {% if step.uses_llm %}
                        <span class="badge">LLM</span>
                        {% endif %}
                        {% if step.recommended_next %}
                        <span class="badge badge-next">Next step</span>
                        {% endif %}
                      </td>
                      <td>
                        {% if step.roles %}
                        {% for role in step.roles %}<code>{{ role }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
                        {% else %}
                        <span class="muted">all items</span>
                        {% endif %}
                      </td>
                      <td>
                        {% if step.needs %}
                        <code>{{ step.needs | join(", ") }}</code>
                        {% elif step.kind == "parse" %}
                        <code>ingest</code>
                        {% else %}
                        <span class="muted">—</span>
                        {% endif %}
                      </td>
                      <td>
                        {% if step.status == "current" %}
                        <span class="badge badge-ok">current</span>
                        {% elif step.status in ("pending", "stale") %}
                        <span class="badge badge-warn">{{ step.status }}</span>
                        {% elif step.status == "failed" %}
                        <span class="badge badge-error">failed</span>
                        {% else %}
                        <span class="badge">{{ step.status | replace("_", " ") }}</span>
                        {% endif %}
                      </td>
                      <td>{{ step.summary }}</td>
                      <td>
                        {% if step.runnable %}
                        <form method="post" action="/_pipeline/run" hx-post="/_pipeline/run" hx-target="#interface-root" hx-swap="outerHTML" hx-disabled-elt="find button">
                          <input type="hidden" name="csrf_token" value="{{ view.csrf_token }}">
                          <input type="hidden" name="step" value="{{ step.key }}">
                          <button type="submit" class="{{ 'btn-compact' if step.recommended_next else 'outline secondary btn-compact' }}"{% if view.locked %} disabled{% endif %}>Run</button>
                          <span class="htmx-indicator run-busy-msg">Running...</span>
                        </form>
                        {% else %}
                        <span class="muted">—</span>
                        {% endif %}
                      </td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </details>
          {% endif %}
        </div>
      </div>
    </header>

    <main class="container app-main">
      {% if notice %}
      <div class="notice {{ 'notice-error' if notice.is_error else 'notice-ok' }}" role="{{ 'alert' if notice.is_error else 'status' }}" aria-live="polite">
        {{ notice.message }}
      </div>
      {% endif %}

      {{ recipe_body }}
    </main>

    <footer class="site-footer app-footer">
      <div class="container app-footer-inner">{{ footer_html }}</div>
    </footer>
  </div>
</div>
