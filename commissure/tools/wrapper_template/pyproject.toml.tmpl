# Wrapper for one Commissure solution, laid out like a client release: one solution under
# solutions/, core pinned by commit. Core is a dependency here, never edited.
# Generated by `commissure dev`; move the pin with `uv run commissure dev repin <sha>`.
[project]
name = "${project}"
version = "0"
requires-python = ">=3.12"
dependencies = ["commissure"]

[tool.uv]
package = false

[tool.uv.sources]
# A committed (file://) or pushed (https://) core revision only: other core work is invisible here.
commissure = { git = "${core_url}", rev = "${rev}" }

[dependency-groups]
dev = [
${dev_deps}]

[tool.commissure-dev]
solution = "${name}"

[tool.pytest.ini_options]
testpaths = ["solutions/${name}/tests"]
norecursedirs = ["workspace", "intake", "docs", "recipe", "releases", "build", "dist", ".*"]
addopts = "-ra --strict-markers -n auto"

# Same style rules as core, so code moving upstream needs no reformatting.
[tool.ruff]
line-length = 100
target-version = "py312"
extend-exclude = ["*.md", ".core"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM"]

[tool.ruff.lint.isort]
known-first-party = ["commissure"]
